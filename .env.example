DATABASE_URL=postgres://burst:burst@localhost:5432/burst

# ── Barbacane public gateway ──
BURST_UPSTREAM_URL=http://127.0.0.1:3000
BURST_UPSTREAM_WS_URL=ws://127.0.0.1:3000

# OIDC (mock OAuth server for local dev)
BURST_OIDC_ISSUER_URL=http://127.0.0.1:9099/burst
BURST_OIDC_ISSUER_OVERRIDE=http://localhost:9099/burst

# ── Barbacane S3 sidecar ──
BURST_S3_REGION=us-east-1
BURST_S3_BUCKET=burst-files
BURST_S3_ACCESS_KEY_ID=burst
BURST_S3_SECRET_ACCESS_KEY=burstpass
BURST_S3_ENDPOINT=http://localhost:9000
BURST_S3_API_KEY=burst-s3-internal-key
