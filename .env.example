DATABASE_URL=postgres://burst:burst@localhost:5432/burst

# ── Barbacane public gateway ──
BURST_UPSTREAM_URL=http://127.0.0.1:3000
BURST_UPSTREAM_WS_URL=ws://127.0.0.1:3000

# OIDC (mock OAuth server for local dev)
BURST_OIDC_ISSUER_URL=http://127.0.0.1:9099/burst
BURST_OIDC_ISSUER_OVERRIDE=http://localhost:9099/burst
# JWT claim that contains user groups/roles (mock server uses "roles")
BURST_OIDC_GROUPS_CLAIM=roles

# ── Google OIDC (production) ──
# Uncomment and set for Google SSO:
# VITE_OIDC_AUTHORITY=https://accounts.google.com
# VITE_OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com
# VITE_OIDC_REDIRECT_URI=https://burst.example.com/callback
# When set, the login page shows "Sign in with Google" button.
# The Barbacane oidc-auth plugin must be configured with the same issuer:
#   BURST_OIDC_ISSUER_URL=https://accounts.google.com
#   BURST_OIDC_ISSUER_OVERRIDE=https://accounts.google.com

# ── Barbacane S3 sidecar ──
BURST_S3_REGION=us-east-1
BURST_S3_BUCKET=burst-files
BURST_S3_ACCESS_KEY_ID=burst
BURST_S3_SECRET_ACCESS_KEY=burstpass
BURST_S3_ENDPOINT=http://localhost:9000
BURST_S3_API_KEY=burst-s3-internal-key
