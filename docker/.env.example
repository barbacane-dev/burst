# Docker Compose secrets — copy to docker/.env and fill in before first run.
# See docker/docker-compose.yaml for usage.

POSTGRES_PASSWORD=changeme
RUSTFS_ROOT_PASSWORD=changeme
S3_API_KEY=changeme

# OIDC provider
BURST_OIDC_ISSUER_URL=https://accounts.google.com
# Optional: override the issuer for local dev (e.g. Docker-to-host networking)
# BURST_OIDC_ISSUER_OVERRIDE=http://localhost:9099/burst
# JWT claim that contains user groups/roles (e.g. "roles" for Keycloak, "groups" for Authelia)
BURST_OIDC_GROUPS_CLAIM=roles
