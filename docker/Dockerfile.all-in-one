# ── Stage 1: Build frontend ───────────────────────────────────────────────────
FROM node:20-slim AS frontend

WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npx vite build

# ── Stage 2: Extract Barbacane binary ─────────────────────────────────────────
FROM ghcr.io/barbacane-dev/barbacane-standalone:0.6.1 AS barbacane

# ── Stage 3: Compile .bca gateway artifacts ───────────────────────────────────
FROM barbacane AS compiler

COPY specs/ /specs/
COPY barbacane.yaml barbacane-s3.yaml /

RUN barbacane compile \
      --spec /specs/burst-api.yaml \
      --manifest /barbacane.yaml \
      --output /burst-api.bca \
      --allow-plaintext && \
    barbacane compile \
      --spec /specs/burst-s3.yaml \
      --manifest /barbacane-s3.yaml \
      --output /burst-s3.bca \
      --allow-plaintext

# ── Stage 4: Runtime ──────────────────────────────────────────────────────────
FROM debian:bookworm-slim

ARG TARGETARCH
ARG S6_OVERLAY_VERSION=3.2.0.2

# Map Docker TARGETARCH to s6-overlay arch naming
RUN case "${TARGETARCH}" in \
      amd64) S6_ARCH="x86_64" ;; \
      arm64) S6_ARCH="aarch64" ;; \
      *) echo "Unsupported arch: ${TARGETARCH}" && exit 1 ;; \
    esac && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      nginx ca-certificates xz-utils curl && \
    curl -fsSL "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz" \
      -o /tmp/s6-noarch.tar.xz && \
    curl -fsSL "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-${S6_ARCH}.tar.xz" \
      -o /tmp/s6-arch.tar.xz && \
    tar -C / -Jxpf /tmp/s6-noarch.tar.xz && \
    tar -C / -Jxpf /tmp/s6-arch.tar.xz && \
    rm -f /tmp/s6-*.tar.xz && \
    apt-get purge -y xz-utils curl && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# ── Copy binaries ────────────────────────────────────────────────────────────
COPY bin/${TARGETARCH}/burst /usr/local/bin/burst
COPY --from=barbacane /usr/local/bin/barbacane /usr/local/bin/barbacane

# ── Copy compiled .bca artifacts ─────────────────────────────────────────────
COPY --from=compiler /burst-api.bca /etc/barbacane/burst-api.bca
COPY --from=compiler /burst-s3.bca /etc/barbacane/burst-s3.bca

# ── Copy frontend static files ───────────────────────────────────────────────
COPY --from=frontend /ui/dist /usr/share/nginx/html

# ── Copy nginx config ────────────────────────────────────────────────────────
COPY docker/all-in-one/nginx.conf /etc/nginx/conf.d/default.conf
RUN rm -f /etc/nginx/sites-enabled/default

# ── Copy runtime env.js generator ────────────────────────────────────────────
COPY docker/env.sh /etc/burst/env.sh
RUN chmod +x /etc/burst/env.sh

# ── Copy Burst config ────────────────────────────────────────────────────────
COPY docker/all-in-one/burst.toml /etc/burst/burst.toml

# ── Copy s6-overlay service definitions ──────────────────────────────────────
COPY docker/all-in-one/s6-rc.d/ /etc/s6-overlay/s6-rc.d/
RUN chmod +x /etc/s6-overlay/s6-rc.d/burst/run \
             /etc/s6-overlay/s6-rc.d/barbacane-api/run \
             /etc/s6-overlay/s6-rc.d/barbacane-s3/run \
             /etc/s6-overlay/s6-rc.d/nginx/run

# ── Internal wiring (not user-configurable) ──────────────────────────────────
ENV BURST_UPSTREAM_URL=http://127.0.0.1:3000 \
    BURST_UPSTREAM_WS_URL=ws://127.0.0.1:3000

EXPOSE 8080 3001

ENTRYPOINT ["/init"]
