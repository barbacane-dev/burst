# Barbacane with Burst's compiled artifacts, for running the gateways without
# compiling at startup:
#   /config/burst-api.bca  the public API gateway (OIDC, ACL, rate limits)
#   /config/burst-s3.bca   the storage gateway, which holds the S3 credentials
# The command picks one, e.g. `serve --artifact /config/burst-api.bca`.
#
# Keep the tag in step with BARBACANE_VERSION in the Makefile and the plugin
# URLs in barbacane.yaml and barbacane-s3.yaml. The compile stage needs 0.12.2 or
# later.
ARG BARBACANE_VERSION=0.12.2

FROM ghcr.io/barbacane-dev/barbacane-standalone:${BARBACANE_VERSION} AS compiler

COPY specs/ /specs/
COPY barbacane.yaml barbacane-s3.yaml /manifests/

RUN barbacane compile \
      --spec /specs/burst-api.yaml \
      --manifest /manifests/barbacane.yaml \
      --output /workspace/burst-api.bca \
      --allow-plaintext && \
    barbacane compile \
      --spec /specs/burst-s3.yaml \
      --manifest /manifests/barbacane-s3.yaml \
      --output /workspace/burst-s3.bca \
      --allow-plaintext

FROM ghcr.io/barbacane-dev/barbacane-standalone:${BARBACANE_VERSION}

COPY --from=compiler /workspace/burst-api.bca /workspace/burst-s3.bca /config/

EXPOSE 8080 8090
